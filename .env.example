# Copy to .env (never committed). DB_PORT is the host port of docker-compose's PostgreSQL.
DB_PORT=5432
DATABASE_URL=postgresql://crewdeck:crewdeck@localhost:5432/crewdeck
PORT=3000
CREWDECK_ENV=development
# The fake GitHub and the fake Runner, with the test scenarios (`pnpm dev` sets it). Never in production.
CREWDECK_FAKES=
# The GitHub App (ADR 0002), to run against the real GitHub without the fakes: a development App of your own.
# The private key: the PEM on one line with its newlines as \n, or base64 -w0 of the .pem.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
# GitHub's API and site, GitHub.com's when empty.
GITHUB_API_URL=
GITHUB_WEB_URL=
