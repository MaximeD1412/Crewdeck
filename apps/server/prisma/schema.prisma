// Crewdeck's database (ADR 0001). Columns in snake_case through @map, every
// table of the Pilote's data with pilot_id (ADR 0008).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  // A Pilote's current Runner, unique among the unrevoked ones (`runners`).
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// A Pilote (CONTEXT.md): global, the scope's own key (ADR 0008), created by
/// their first sign-in with GitHub (CORE-4). `seq` is the number of its last
/// event (CORE-5). Ids are
/// UUIDv7, generated in code (`src/ids.ts`).
model Pilot {
  id             String               @id @db.Uuid
  githubUserId   BigInt               @unique @map("github_user_id")
  login          String
  avatarUrl      String?              @map("avatar_url")
  timeZone       String               @map("time_zone")
  seq            BigInt               @default(0)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz
  githubToken    GithubUserToken?
  webSessions    WebSession[]
  events         Event[]
  installations  GitHubInstallation[]
  runners        Runner[]
  latencySamples LatencySample[]
  settings       AccountSettings?

  @@map("pilots")
}

/// The Pilote's GitHub user tokens (ADR 0002), one row each, encrypted with
/// `GITHUB_TOKEN_KEY` (`src/auth/token-cipher.ts`): the server reads them only
/// to hand the page its access token, or to refresh it.
model GithubUserToken {
  pilotId          String   @id @map("pilot_id") @db.Uuid
  accessTokenEnc   Bytes    @map("access_token_enc")
  accessExpiresAt  DateTime @map("access_expires_at") @db.Timestamptz
  refreshTokenEnc  Bytes    @map("refresh_token_enc")
  refreshExpiresAt DateTime @map("refresh_expires_at") @db.Timestamptz
  keyVersion       Int      @map("key_version")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz
  pilot            Pilot    @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@map("github_user_tokens")
}

/// A signed-in browser: the `crewdeck_session` cookie holds a random token,
/// the row only its SHA-256 in hex. It lasts 30 days from its last use.
model WebSession {
  id         String   @id @db.Uuid
  pilotId    String   @map("pilot_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  userAgent  String?  @map("user_agent")
  pilot      Pilot    @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@index([pilotId])
  @@map("web_sessions")
}

/// What changed in the Process of a Pilote (ADR 0007), written by
/// `EventsWriter` in the transaction of the change, numbered by the Pilote's
/// `seq`: the tables are the truth, an event only tells the page what changed.
/// Kept 7 days (`src/realtime/retention.job.ts`).
model Event {
  pilotId  String    @map("pilot_id") @db.Uuid
  seq      BigInt
  /// `<resource>.upserted` or `<resource>.removed` (`zEventType`).
  type     String
  /// The resource as the API returns it, or `{ id }` for a removal.
  payload  Json
  at       DateTime  @default(now()) @db.Timestamptz
  /// When its source saw the change (a webhook's delivery, a Runner's report).
  sourceAt DateTime? @map("source_at") @db.Timestamptz
  /// Which source it is: `github`, `runner`, `pilot` or `scheduler` (`zEventSource`).
  source   String?
  pilot    Pilot     @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@id([pilotId, seq])
  @@index([at])
  @@map("events")
}

enum RunnerState {
  online
  offline

  @@map("runner_state")
}

enum RunnerOs {
  linux
  darwin

  @@map("runner_os")
}

enum RunnerArch {
  amd64
  arm64

  @@map("runner_arch")
}

/// A Pilote's Runner (ADR 0004), created by its link (RUNNER-3): one per
/// Pilote, linking a new one revokes the old (`revokedAt`). Its token is 32
/// random bytes the Runner keeps, the row only its SHA-256 in hex. Its
/// machine is the one its last `hello` described; `state` and `lastSeenAt`
/// follow its heartbeats (`src/runners/runner-presence.service.ts`).
model Runner {
  id              String      @id @db.Uuid
  pilotId         String      @map("pilot_id") @db.Uuid
  tokenHash       String      @unique @map("token_hash")
  machine         String
  os              RunnerOs
  arch            RunnerArch
  wsl             Boolean
  runnerVersion   String      @map("runner_version")
  protocolVersion Int         @map("protocol_version")
  state           RunnerState @default(offline)
  lastSeenAt      DateTime    @map("last_seen_at") @db.Timestamptz
  linkedAt        DateTime    @default(now()) @map("linked_at") @db.Timestamptz
  revokedAt       DateTime?   @map("revoked_at") @db.Timestamptz
  pilot           Pilot       @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@unique([pilotId], map: "runners_pilot_id_current_key", where: raw("revoked_at IS NULL"))
  @@index([pilotId])
  @@index([state, lastSeenAt])
  @@map("runners")
}

/// The Paramètres of the Pilote's account (PARAM-1), the default of each of
/// their Projets: no row until they change one, `SettingsService` then reads
/// the defaults. `roles` and `optionalSteps` are JSON, parsed by the
/// contract's schemas on every read. The time zone stays on `pilots`.
model AccountSettings {
  pilotId           String   @id @map("pilot_id") @db.Uuid
  roles             Json
  optionalSteps     Json     @map("optional_steps")
  notificationsPush Boolean  @default(false) @map("notifications_push")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz
  pilot             Pilot    @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@map("account_settings")
}

/// A webhook delivery GitHub sent (ADR 0002), by its `X-GitHub-Delivery`:
/// global, recorded once its signature is valid, so that a redelivery is
/// dispatched once. Its payload is never stored. Kept 7 days
/// (`src/github/webhooks/deliveries.retention.ts`).
model GitHubDelivery {
  deliveryId String   @id @map("delivery_id")
  /// `X-GitHub-Event`: `installation`, `issues`, `pull_request`…
  event      String
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz

  @@index([receivedAt])
  @@map("github_deliveries")
}

/// The App's installations index (ADR 0008): global, what a webhook's
/// `installation.id` gives the Pilote of, maintained from the `installation`
/// events. `pilotId` is null until the GitHub user who installed it
/// (`senderId`) signs in as a Pilote.
model GitHubInstallation {
  installationId BigInt   @id @map("installation_id")
  /// The account it is installed on, a user or an organisation.
  accountLogin   String   @map("account_login")
  accountId      BigInt   @map("account_id")
  /// The GitHub user who installed it (`sender.id` of `installation.created`): the Pilote it is linked to.
  senderId       BigInt   @map("sender_id")
  pilotId        String?  @map("pilot_id") @db.Uuid
  suspended      Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  pilot          Pilot?   @relation(fields: [pilotId], references: [id], onDelete: SetNull)

  @@index([pilotId])
  @@index([senderId])
  @@map("github_installations")
}

/// A latency the page measured (CORE-8, US-20): an event of `source` applied
/// `delayMs` after its source saw the change, at `at`. Not an event: nothing
/// is sent in real time, the statistics read the p95 of 7 days
/// (`src/metrics/latency.service.ts`). Kept 30 days
/// (`src/metrics/latency.retention.ts`).
model LatencySample {
  id      String   @id @db.Uuid
  pilotId String   @map("pilot_id") @db.Uuid
  /// `github`, `runner`, `pilot` or `scheduler` (`zEventSource`).
  source  String
  delayMs Int      @map("delay_ms")
  at      DateTime @db.Timestamptz
  pilot   Pilot    @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@index([pilotId, at])
  @@index([at])
  @@map("latency_samples")
}
