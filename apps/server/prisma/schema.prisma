// Crewdeck's database (ADR 0001). Columns in snake_case through @map, every
// table of the Pilote's data with pilot_id (ADR 0008).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  // A Pilote's current Runner, unique among the unrevoked ones (`runners`);
  // a subject's open Décision (`decisions`).
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// The steps of « Premiers pas » (US-2, RUNNER-3), in order.
enum GettingStartedStep {
  runner
  ai_accounts @map("ai-accounts")
  projects
  done

  @@map("getting_started_step")
}

/// A Pilote (CONTEXT.md): global, the scope's own key (ADR 0008), created by
/// their first sign-in with an Identité no Pilote has (ADR 0014). `seq` is the
/// number of its last event (CORE-5), `lastSeq` the one of the last event
/// about the Pilote themselves (`pilot.upserted`). Ids are UUIDv7, generated
/// in code (`src/ids.ts`). `githubUserId` and `login` are no longer read nor
/// written by the server (the `github` Identité holds them; a trigger copies
/// them back for the version before): CORE-11's migration drops them.
model Pilot {
  id                 String               @id @db.Uuid
  githubUserId       BigInt?              @unique @map("github_user_id")
  login              String?
  /// The Pilote's readable name: GitHub's login, or their address's local part.
  displayName        String               @map("display_name")
  avatarUrl          String?              @map("avatar_url")
  timeZone           String               @map("time_zone")
  gettingStartedStep GettingStartedStep   @default(runner) @map("getting_started_step")
  seq                BigInt               @default(0)
  lastSeq            BigInt               @default(0) @map("last_seq")
  /// The last `github_changes.seq` of the Pilote (ADR 0010): the Miroir's
  /// own counter, never shared with the tabs' `seq`.
  githubChangeSeq    BigInt               @default(0) @map("github_change_seq")
  /// The version of the Pilote's vault key (ADR 0003, E2E-2): 0 before the
  /// first Appareil wrapped one, then 1; E2E-4 rotates it.
  vaultKeyVersion    Int                  @default(0) @map("vault_key_version")
  /// The last `#<n>` of the Pilote's Idées (IDEE-1), raised in the transaction that notes one.
  ideaSeq            Int                  @default(0) @map("idea_seq")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz
  identities         PilotIdentity[]
  githubToken        GithubUserToken?
  webSessions        WebSession[]
  events             Event[]
  installations      GitHubInstallation[]
  runners            Runner[]
  runnerLinkCodes    RunnerLinkCode[]
  latencySamples     LatencySample[]
  aiAccounts         AiAccount[]
  mcpServers         McpServer[]
  devices            Device[]
  vaultKeyWraps      VaultKeyWrap[]
  repositories       Repository[]
  projects           Project[]
  decisions          Decision[]
  ideas              Idea[]
  tickets            Ticket[]
  milestones         Milestone[]
  codeChanges        CodeChange[]
  codeChangeChecks   CodeChangeCheck[]
  githubChanges      GitHubChange[]
  settings           AccountSettings?
  customRoles        CustomRole[]
  agentSessions      AgentSession[]

  @@map("pilots")
}

/// How a Pilote signs in (ADR 0014).
enum IdentityProvider {
  email
  google
  github

  @@map("identity_provider")
}

/// An Identité of a Pilote (CONTEXT.md, ADR 0014): at most one per provider.
/// `subject` is the lower-cased address, Google's `sub`, or GitHub's user id
/// in decimal; `email` the verified address (`email`, `google`), `login`
/// GitHub's login (`github`). The address is readable by the server, which
/// mails it (ADR 0003), and never logged.
model PilotIdentity {
  id        String           @id @db.Uuid
  pilotId   String           @map("pilot_id") @db.Uuid
  provider  IdentityProvider
  subject   String
  email     String?
  login     String?
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  pilot     Pilot            @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@unique([pilotId, provider])
  @@index([pilotId])
  @@map("pilot_identities")
}

/// A sign-in link sent by email (ADR 0014): global, it exists before its
/// Pilote. Only the SHA-256 in hex of its token is kept; it lasts 15 minutes
/// and is used once (`usedAt`). Rows older than 24 hours are deleted
/// (`EmailLoginTokensSweep`); the last hour's count an address's links.
model EmailLoginToken {
  id        String    @id @db.Uuid
  /// Lower-cased.
  email     String
  tokenHash String    @unique @map("token_hash")
  /// The page to land on once signed in.
  next      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz

  @@index([email, createdAt])
  @@map("email_login_tokens")
}

/// The Pilote's GitHub user tokens (ADR 0002), one row each, encrypted with
/// `GITHUB_TOKEN_KEY` (`src/auth/token-cipher.ts`): the server reads them only
/// to hand the page its access token, or to refresh it.
model GithubUserToken {
  pilotId          String   @id @map("pilot_id") @db.Uuid
  accessTokenEnc   Bytes    @map("access_token_enc")
  accessExpiresAt  DateTime @map("access_expires_at") @db.Timestamptz
  refreshTokenEnc  Bytes    @map("refresh_token_enc")
  refreshExpiresAt DateTime @map("refresh_expires_at") @db.Timestamptz
  keyVersion       Int      @map("key_version")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz
  pilot            Pilot    @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@map("github_user_tokens")
}

/// A signed-in browser: the `crewdeck_session` cookie holds a random token,
/// the row only its SHA-256 in hex. It lasts 30 days from its last use.
model WebSession {
  id         String   @id @db.Uuid
  pilotId    String   @map("pilot_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  userAgent  String?  @map("user_agent")
  pilot      Pilot    @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@index([pilotId])
  @@map("web_sessions")
}

/// What changed in the Process of a Pilote (ADR 0007), written by
/// `EventsWriter` in the transaction of the change, numbered by the Pilote's
/// `seq`: the tables are the truth, an event only tells the page what changed.
/// Kept 7 days (`src/realtime/retention.job.ts`).
model Event {
  pilotId  String    @map("pilot_id") @db.Uuid
  seq      BigInt
  /// `<resource>.upserted` or `<resource>.removed` (`zEventType`).
  type     String
  /// The resource as the API returns it, or `{ id }` for a removal.
  payload  Json
  at       DateTime  @default(now()) @db.Timestamptz
  /// When its source saw the change (a webhook's delivery, a Runner's report).
  sourceAt DateTime? @map("source_at") @db.Timestamptz
  /// Which source it is: `github`, `runner`, `pilot` or `scheduler` (`zEventSource`).
  source   String?
  pilot    Pilot     @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@id([pilotId, seq])
  @@index([at])
  @@map("events")
}

enum RunnerState {
  online
  offline

  @@map("runner_state")
}

enum RunnerOs {
  linux
  darwin

  @@map("runner_os")
}

enum RunnerArch {
  amd64
  arm64

  @@map("runner_arch")
}

/// A Pilote's Runner (ADR 0004), created by its link (RUNNER-3): one per
/// Pilote, linking a new one revokes the old (`revokedAt`). Its token is 32
/// random bytes the Runner keeps, the row only its SHA-256 in hex. Its
/// machine is the one its last `hello` described; `state` and `lastSeenAt`
/// follow its heartbeats (`src/runners/runner-presence.service.ts`).
model Runner {
  id              String      @id @db.Uuid
  pilotId         String      @map("pilot_id") @db.Uuid
  tokenHash       String      @unique @map("token_hash")
  machine         String
  os              RunnerOs
  arch            RunnerArch
  wsl             Boolean
  runnerVersion   String      @map("runner_version")
  protocolVersion Int         @map("protocol_version")
  state           RunnerState @default(offline)
  lastSeenAt      DateTime    @map("last_seen_at") @db.Timestamptz
  linkedAt        DateTime    @default(now()) @map("linked_at") @db.Timestamptz
  revokedAt       DateTime?   @map("revoked_at") @db.Timestamptz
  pilot           Pilot       @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@unique([pilotId], map: "runners_pilot_id_current_key", where: raw("revoked_at IS NULL"))
  @@index([pilotId])
  @@index([state, lastSeenAt])
  @@map("runners")
}

enum RunnerLinkState {
  waiting
  pending
  linked
  failed
  expired

  @@map("runner_link_state")
}

enum RunnerLinkFailure {
  expired
  already_used       @map("already-used")
  unsupported_system @map("unsupported-system")
  no_engine          @map("no-engine")
  pairing_mismatch   @map("pairing-mismatch")
  device_not_trusted @map("device-not-trusted")

  @@map("runner_link_failure")
}

/// A link code the page drew (ADR 0003, RUNNER-3): the server knows only its
/// `shortId`, never its secret. `waiting` for a Runner, `pending` once one
/// called `POST /api/runner/link` with it (`pendingRunner` its machine), then
/// `linked` when the page confirmed it, `failed` (`failureReason`) or
/// `expired` 10 minutes after its creation. The pairings (E2E-2) hold only
/// public keys, proofs and wraps: the page's (`browserPairing`), the Runner's
/// (`runnerPairing`), the page's answer to it (`confirmPairing`). `deviceId`
/// is the Appareil of the page that drew it; `runnerId` is drawn once a
/// Runner took it (its vault wrap binds it), the Runner created with it at
/// the confirmation.
model RunnerLinkCode {
  id             String             @id @db.Uuid
  pilotId        String             @map("pilot_id") @db.Uuid
  shortId        String             @map("short_id")
  state          RunnerLinkState    @default(waiting)
  failureReason  RunnerLinkFailure? @map("failure_reason")
  browserPairing Json               @map("browser_pairing")
  runnerPairing  Json?              @map("runner_pairing")
  confirmPairing Json?              @map("confirm_pairing")
  pendingRunner  Json?              @map("pending_runner")
  /// The Runner it links, drawn when it becomes `pending`.
  runnerId       String?            @map("runner_id") @db.Uuid
  deviceId       String?            @map("device_id") @db.Uuid
  expiresAt      DateTime           @map("expires_at") @db.Timestamptz
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  lastSeq        BigInt             @default(0) @map("last_seq")
  pilot          Pilot              @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@unique([shortId], map: "runner_link_codes_short_id_live_key", where: raw("state IN ('waiting', 'pending')"))
  @@index([pilotId, createdAt])
  @@index([shortId])
  @@index([state, expiresAt])
  @@map("runner_link_codes")
}

enum DeviceState {
  pending
  trusted
  revoked

  @@map("device_state")
}

/// An Appareil (ADR 0003, E2E-2): a browser of the Pilote with its X25519 key
/// pair, the server holding only the 32-byte public key. Created `pending`
/// by the page that draws a link code; `trusted` once it holds the vault key
/// (`approvedAt`); `revoked` by the Pilote (E2E-4). `lastSeenAt` follows its
/// `X-Crewdeck-Device` header, at most once an hour.
model Device {
  id                String              @id @db.Uuid
  pilotId           String              @map("pilot_id") @db.Uuid
  name              String
  publicKey         Bytes               @map("public_key")
  state             DeviceState         @default(pending)
  approvedAt        DateTime?           @map("approved_at") @db.Timestamptz
  revokedAt         DateTime?           @map("revoked_at") @db.Timestamptz
  lastSeenAt        DateTime?           @map("last_seen_at") @db.Timestamptz
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  /// A new Appareil's code (E2E-3): its short id while it waits, the proof of its public key, its expiry.
  shortId           String?             @map("short_id")
  proof             Bytes?
  expiresAt         DateTime?           @map("expires_at") @db.Timestamptz
  /// Who approved it by its code, the public key that sealed its wrap, and their proof.
  approverType      VaultKeyHolderType? @map("approver_type")
  approverId        String?             @map("approver_id") @db.Uuid
  approverPublicKey Bytes?              @map("approver_public_key")
  approvalProof     Bytes?              @map("approval_proof")
  /// For the Sessions: the Runner's key a trusted approver handed on and its proof, for the new page.
  runnerPublicKey   Bytes?              @map("runner_public_key")
  runnerProof       Bytes?              @map("runner_proof")
  /// For the Sessions: the new public key in a wrap from the approver to the Runner.
  holderEnc         Bytes?              @map("holder_enc")
  holderCiphertext  Bytes?              @map("holder_ciphertext")
  holderTag         Bytes?              @map("holder_tag")
  pilot             Pilot               @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@unique([pilotId, shortId], map: "devices_pilot_id_short_id_pending_key", where: raw("state = 'pending' AND short_id IS NOT NULL"))
  @@index([pilotId, createdAt])
  @@map("devices")
}

enum VaultKeyHolderType {
  device
  runner

  @@map("vault_key_holder_type")
}

/// The Pilote's vault key wrapped for one key holder (ADR 0003, E2E-2): an
/// authenticated HPKE wrap (`docs/security/e2e.md`), its additional data
/// `"<holderId>:<vaultKeyVersion>"`. The server never sees the key itself.
model VaultKeyWrap {
  id              String             @id @db.Uuid
  pilotId         String             @map("pilot_id") @db.Uuid
  holderType      VaultKeyHolderType @map("holder_type")
  /// A Device's or a Runner's id.
  holderId        String             @map("holder_id") @db.Uuid
  vaultKeyVersion Int                @map("vault_key_version")
  enc             Bytes
  ciphertext      Bytes
  tag             Bytes
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  pilot           Pilot              @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@unique([holderType, holderId, vaultKeyVersion])
  @@index([pilotId, holderId])
  @@map("vault_key_wraps")
}

/// The Paramètres of the Pilote's account (PARAM-1), the default of each of
/// their Projets: no row until they change one, `SettingsService` then reads
/// the defaults. `roles` and `optionalSteps` are JSON, parsed by the
/// contract's schemas on every read. The time zone stays on `pilots`.
model AccountSettings {
  pilotId           String   @id @map("pilot_id") @db.Uuid
  roles             Json
  optionalSteps     Json     @map("optional_steps")
  notificationsPush Boolean  @default(false) @map("notifications_push")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz
  pilot             Pilot    @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@map("account_settings")
}

/// A Rôle the Pilote added (PARAM-2), beside the four default ones: its id
/// (`r-` then 8 characters, drawn by the server, stable: a Process names it),
/// its name, unique per Pilote case aside (`nameKey`, the four default names
/// refused by the service), and its own Moteur and model, never left to a
/// default. At most 20 per Pilote. Its name is configuration the server
/// reads (ADR 0011), not ciphertext.
model CustomRole {
  id        String   @id
  pilotId   String   @map("pilot_id") @db.Uuid
  name      String
  nameKey   String   @map("name_key")
  engine    EngineId
  model     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  pilot     Pilot    @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@unique([pilotId, nameKey])
  @@map("custom_roles")
}

/// A webhook delivery GitHub sent (ADR 0002), by its `X-GitHub-Delivery`:
/// global, recorded once its signature is valid, so that a redelivery is
/// dispatched once. Its payload is never stored. Kept 7 days
/// (`src/github/webhooks/deliveries.retention.ts`).
model GitHubDelivery {
  deliveryId String   @id @map("delivery_id")
  /// `X-GitHub-Event`: `installation`, `issues`, `pull_request`…
  event      String
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz

  @@index([receivedAt])
  @@map("github_deliveries")
}

/// The App's installations index (ADR 0008): global, what a webhook's
/// `installation.id` gives the Pilote of, maintained from the `installation`
/// events. `pilotId` is null until the GitHub user who installed it
/// (`senderId`) signs in as a Pilote.
model GitHubInstallation {
  installationId BigInt   @id @map("installation_id")
  /// The account it is installed on, a user or an organisation.
  accountLogin   String   @map("account_login")
  accountId      BigInt   @map("account_id")
  /// The GitHub user who installed it (`sender.id` of `installation.created`): the Pilote it is linked to.
  senderId       BigInt   @map("sender_id")
  pilotId        String?  @map("pilot_id") @db.Uuid
  suspended      Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  pilot          Pilot?   @relation(fields: [pilotId], references: [id], onDelete: SetNull)

  @@index([pilotId])
  @@index([senderId])
  @@map("github_installations")
}

enum DecisionState {
  open
  resolved

  @@map("decision_state")
}

enum DecisionTone {
  accent
  caution
  halt

  @@map("decision_tone")
}

/// A Décision (CONTEXT.md, ATOI-1): something that waits for the Pilote, raised
/// and resolved by its module through `DecisionsService`. One open per
/// `(kind, subjectId)`: raising it again updates it. Resolved, it stays for
/// the history (US-78). `kind` is one of `DECISION_KINDS` (a text column, so a
/// new kind needs no migration). Its values are readable by the server
/// (ADR 0003): never free text of the Pilote or an agent. `projectId` is the
/// Projet's id, with no foreign key until the Projets' table (PROJET-1).
model Decision {
  id          String        @id @db.Uuid
  pilotId     String        @map("pilot_id") @db.Uuid
  kind        String
  projectId   String?       @map("project_id") @db.Uuid
  projectName String?       @map("project_name")
  subjectType String        @map("subject_type")
  subjectId   String        @map("subject_id")
  label       String
  metaParts   String[]      @map("meta_parts")
  tone        DecisionTone
  link        String
  params      Json
  state       DecisionState @default(open)
  outcome     String?
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt  DateTime?     @map("resolved_at") @db.Timestamptz
  pilot       Pilot         @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@unique([pilotId, kind, subjectId], map: "decisions_pilot_id_kind_subject_id_open_key", where: raw("state = 'open'"))
  @@index([pilotId, state, createdAt])
  @@map("decisions")
}

/// A latency the page measured (CORE-8, US-20): an event of `source` applied
/// `delayMs` after its source saw the change, at `at`. Not an event: nothing
/// is sent in real time, the statistics read the p95 of 7 days
/// (`src/metrics/latency.service.ts`). Kept 30 days
/// (`src/metrics/latency.retention.ts`).
model LatencySample {
  id      String   @id @db.Uuid
  pilotId String   @map("pilot_id") @db.Uuid
  /// `github`, `runner`, `pilot` or `scheduler` (`zEventSource`).
  source  String
  delayMs Int      @map("delay_ms")
  at      DateTime @db.Timestamptz
  pilot   Pilot    @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@index([pilotId, at])
  @@index([at])
  @@map("latency_samples")
}

/// A Moteur (`zEngineId`).
enum EngineId {
  claude_code @map("claude-code")
  codex

  @@map("engine_id")
}

/// How a Compte IA is connected (`ENGINE_ACCOUNT_KINDS`).
enum AiAccountKind {
  subscription
  api_key      @map("api-key")
  none

  @@map("ai_account_kind")
}

/// Whether a Compte IA can run (`ENGINE_ACCOUNT_STATES`).
enum AiAccountState {
  connected
  login_required @map("login-required")

  @@map("ai_account_state")
}

/// A Compte IA (US-38, RUNNER-7): what one Moteur can run on the Pilote's
/// Runner, from its last `capabilities` message, one row per Moteur. Its kind
/// and state only: no credential field, ever (PRD, « Principles »), the key
/// stays on the Runner. `models` is `zAiAccountModel[]`.
model AiAccount {
  id           String         @id @db.Uuid
  pilotId      String         @map("pilot_id") @db.Uuid
  engine       EngineId
  installed    Boolean
  version      String?
  knownVersion Boolean        @map("known_version")
  kind         AiAccountKind
  state        AiAccountState
  models       Json
  reportedAt   DateTime       @map("reported_at") @db.Timestamptz
  pilot        Pilot          @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@unique([pilotId, engine])
  @@map("ai_accounts")
}

/// How a Serveur MCP is reached (`MCP_TRANSPORTS`).
enum McpTransport {
  stdio
  http

  @@map("mcp_transport")
}

/// The outcome of a Serveur MCP's last test on the Runner (`MCP_SERVER_STATES`).
enum McpServerState {
  ready
  failed

  @@map("mcp_server_state")
}

/// A Serveur MCP declared on the Pilote's Runner (US-73, RUNNER-16, ADR 0013),
/// from its last `mcp.servers` message, one row per name: each message
/// replaces the Pilote's set. Its name, transport, state and tool count only:
/// no column for its command, address or secrets, which stay on the Runner
/// (risk SEC-13). `toolCount` is null when its last test failed.
model McpServer {
  id         String         @id @db.Uuid
  pilotId    String         @map("pilot_id") @db.Uuid
  name       String
  transport  McpTransport
  state      McpServerState
  toolCount  Int?           @map("tool_count")
  reportedAt DateTime       @map("reported_at") @db.Timestamptz
  pilot      Pilot          @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@unique([pilotId, name])
  @@map("mcp_servers")
}

/// A Dépôt GitHub (PROJET-2): a repository one of the Pilote's installations
/// of the App reaches, kept in step by the webhooks and the reconciliation.
/// Metadata only (ADR 0002): no file, no commit, no description.
model Repository {
  id             String   @id @db.Uuid
  pilotId        String   @map("pilot_id") @db.Uuid
  installationId BigInt   @map("installation_id")
  /// GitHub's id, which survives a rename.
  githubId       BigInt   @map("github_id")
  owner          String
  name           String
  fullName       String   @map("full_name")
  private        Boolean
  defaultBranch  String   @map("default_branch")
  /// At least 2 commits on the default branch: an initial commit alone is a new repository.
  hasCode        Boolean  @map("has_code")
  /// The `seq` of its last event (ADR 0007): following it is refused when older.
  lastSeq        BigInt   @default(0) @map("last_seq")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz
  pilot          Pilot    @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@unique([pilotId, githubId])
  @@index([pilotId, name])
  @@map("repositories")
}

enum InventoryState {
  not_needed     @map("not-needed")
  pending
  drafting
  to_approve     @map("to-approve")
  awaiting_merge @map("awaiting-merge")
  approved

  @@map("inventory_state")
}

/// A Projet (PROJET-2): a Dépôt GitHub the Pilote follows. It outlives its
/// repository's row: a repository the installation no longer reaches is
/// deleted, its Projet marked `accessLost`, and `repositoryId` is given back
/// to the repository when it comes back.
model Project {
  id                String           @id @db.Uuid
  pilotId           String           @map("pilot_id") @db.Uuid
  repositoryId      String           @unique @map("repository_id") @db.Uuid
  githubRepoId      BigInt           @map("github_repo_id")
  owner             String
  name              String
  fullName          String           @map("full_name")
  displayName       String           @map("display_name")
  releaseBranch     String           @map("release_branch")
  integrationBranch String           @map("integration_branch")
  hasCode           Boolean          @map("has_code")
  inventoryState    InventoryState   @map("inventory_state")
  accessLost        Boolean          @default(false) @map("access_lost")
  lastSeq           BigInt           @default(0) @map("last_seq")
  followedAt        DateTime         @default(now()) @map("followed_at") @db.Timestamptz
  pilot             Pilot            @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  tickets           Ticket[]
  milestones        Milestone[]
  codeChanges       CodeChange[]
  processVersions   ProcessVersion[]
  processDraft      ProcessDraft?
  phaseRuns         PhaseRun[]
  stepRuns          StepRun[]
  artifactSources   ArtifactSource[]
  ideas             Idea[]           @relation("IdeaProject")
  targetedIdeas     Idea[]           @relation("IdeaTarget")
  agentSessions     AgentSession[]

  @@unique([pilotId, githubRepoId])
  /// The key the Projet's Tickets, milestones, changes of code and Process point at, with their Pilote.
  @@unique([pilotId, id])
  @@map("projects")
}

/// What a change of GitHub names (`zGitHubChangeKind`).
enum GitHubChangeKind {
  issue
  pull
  push
  check
  release
  label
  milestone

  @@map("github_change_kind")
}

/// The envelope of each webhook of a Projet's repository, for the Runner's
/// Miroir (ADR 0010): identifiers, states and dates only, never a title, a
/// body, a label's name nor a branch other than `ref` (ADR 0003). `seq` comes
/// from `pilots.github_change_seq`. Kept 7 days (`GitHubChangesRetention`);
/// `projectId` has no foreign key: a removed Projet's envelopes age out.
model GitHubChange {
  pilotId    String           @map("pilot_id") @db.Uuid
  seq        BigInt
  projectId  String           @map("project_id") @db.Uuid
  /// `<owner>/<name>`.
  repository String
  kind       GitHubChangeKind
  number     Int?
  sha        String?
  ref        String?
  action     String?
  /// When the server received the webhook.
  at         DateTime         @db.Timestamptz
  pilot      Pilot            @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@id([pilotId, seq])
  @@index([at])
  @@map("github_changes")
}

/// Where a row of `tickets`, `milestones` or `code_changes` comes from (ADR
/// 0012): `github`, its texts readable; `local`, its texts sealed by the
/// Runner under the vault key (a `CHECK` of each table holds it).
enum TicketSource {
  github
  local

  @@map("ticket_source")
}

enum TicketState {
  open
  closed

  @@map("ticket_state")
}

enum TicketStateReason {
  completed
  not_planned

  @@map("ticket_state_reason")
}

enum TicketPriority {
  P0
  P1
  P2

  @@map("ticket_priority")
}

enum TicketSize {
  XS
  S
  M
  L
  XL

  @@map("ticket_size")
}

enum BranchPrefix {
  feat
  fix
  chore

  @@map("branch_prefix")
}

/// A Ticket of a Projet (BOUCLE-1), whatever its Source: its number, state,
/// readable labels (all of GitHub's, the product's only for Local), the
/// figures the Boucle reads, its native blocked-by and parent, and `ready`,
/// stored and recomputed in the transaction that moves it
/// (`src/tickets/tickets.writer.ts`, the one writer). Never a body.
model Ticket {
  id              String             @id @db.Uuid
  pilotId         String             @map("pilot_id") @db.Uuid
  projectId       String             @map("project_id") @db.Uuid
  source          TicketSource
  number          Int
  /// GitHub's title; null for Local.
  title           String?
  /// Local's title, a `SealedItem`; null for GitHub.
  titleSealed     Json?              @map("title_sealed")
  state           TicketState
  stateReason     TicketStateReason? @map("state_reason")
  closedAt        DateTime?          @map("closed_at") @db.Timestamptz
  /// `ready-for-agent` on GitHub, the front matter's `ready` on Local.
  readyMark       Boolean            @map("ready_mark")
  ready           Boolean
  labels          String[]
  /// Local's other labels, one `SealedItem`.
  labelsSealed    Json?              @map("labels_sealed")
  priority        TicketPriority?
  size            TicketSize?
  milestoneNumber Int?               @map("milestone_number")
  /// The numbers of the Tickets of the same Projet it is blocked by.
  blockedBy       Int[]              @map("blocked_by")
  parentNumber    Int?               @map("parent_number")
  branchPrefix    BranchPrefix       @map("branch_prefix")
  visualReview    Boolean            @map("visual_review")
  sourceCreatedAt DateTime           @map("source_created_at") @db.Timestamptz
  sourceUpdatedAt DateTime           @map("source_updated_at") @db.Timestamptz
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  pilot           Pilot              @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  project         Project            @relation(fields: [pilotId, projectId], references: [pilotId, id], onDelete: Cascade)

  @@unique([projectId, number])
  @@index([pilotId, projectId, number])
  @@index([pilotId, state, closedAt])
  @@map("tickets")
}

/// A milestone of a Projet: `rank` orders them, readable for both Sources.
model Milestone {
  id          String       @id @db.Uuid
  pilotId     String       @map("pilot_id") @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  source      TicketSource
  number      Int
  rank        Int
  title       String?
  titleSealed Json?        @map("title_sealed")
  state       TicketState
  dueOn       DateTime?    @map("due_on") @db.Date
  openCount   Int          @map("open_count")
  closedCount Int          @map("closed_count")
  closedAt    DateTime?    @map("closed_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  pilot       Pilot        @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  project     Project      @relation(fields: [pilotId, projectId], references: [pilotId, id], onDelete: Cascade)

  @@unique([projectId, number])
  @@index([pilotId, state, closedAt])
  @@map("milestones")
}

enum CodeChangeState {
  draft
  open
  merged
  closed

  @@map("code_change_state")
}

enum ChecksState {
  none
  pending
  passed
  failed

  @@map("checks_state")
}

/// `loop` for a merge by `crewdeck[bot]`, `pilot` for anyone else.
enum MergedBy {
  loop
  pilot

  @@map("merged_by")
}

/// A change of code (a pull request on GitHub): the Ticket it delivers, read
/// from its head branch only, and the `checks` of its head (`checksSha`).
model CodeChange {
  id              String            @id @db.Uuid
  pilotId         String            @map("pilot_id") @db.Uuid
  projectId       String            @map("project_id") @db.Uuid
  source          TicketSource
  number          Int
  ticketNumber    Int?              @map("ticket_number")
  title           String?
  titleSealed     Json?             @map("title_sealed")
  state           CodeChangeState
  headRef         String?           @map("head_ref")
  baseRef         String            @map("base_ref")
  headSha         String?           @map("head_sha")
  checks          ChecksState       @default(none)
  checksSha       String?           @map("checks_sha")
  mergedAt        DateTime?         @map("merged_at") @db.Timestamptz
  mergedBy        MergedBy?         @map("merged_by")
  mergeSha        String?           @map("merge_sha")
  sourceCreatedAt DateTime          @map("source_created_at") @db.Timestamptz
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  pilot           Pilot             @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  project         Project           @relation(fields: [pilotId, projectId], references: [pilotId, id], onDelete: Cascade)
  checkRows       CodeChangeCheck[]

  @@unique([projectId, number])
  /// The key its checks point at, with their Pilote.
  @@unique([pilotId, id])
  @@index([pilotId, projectId, ticketNumber])
  @@index([pilotId, state, updatedAt])
  @@map("code_changes")
}

enum CheckState {
  running
  passed
  failed

  @@map("check_state")
}

/// A check run or a commit status of a change of code, on one commit: its
/// state, never its output.
model CodeChangeCheck {
  id           String     @id @db.Uuid
  pilotId      String     @map("pilot_id") @db.Uuid
  codeChangeId String     @map("code_change_id") @db.Uuid
  sha          String
  name         String
  state        CheckState
  durationMs   Int?       @map("duration_ms")
  url          String?
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  pilot        Pilot      @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  codeChange   CodeChange @relation(fields: [pilotId, codeChangeId], references: [pilotId, id], onDelete: Cascade)

  @@unique([codeChangeId, sha, name])
  @@index([pilotId, codeChangeId, sha])
  @@map("code_change_checks")
}

/// Who activated a version of a Process: the Projet's creation (its Modèle copied), or the Pilote (PROCESS-10).
enum ProcessActivation {
  creation
  pilot

  @@map("process_activation")
}

/// A version of a Projet's Process (ADR 0011): one immutable document, numbered
/// from 1 per Projet, its Commandes' text in `sealed` (a `SealedItem`, stored
/// as received). A trigger of the migration refuses any `UPDATE`; the active
/// version is the highest number.
model ProcessVersion {
  id           String            @id @db.Uuid
  pilotId      String            @map("pilot_id") @db.Uuid
  projectId    String            @map("project_id") @db.Uuid
  number       Int
  /// A `ProcessDefinition`: configuration the server reads.
  definition   Json
  sealed       Json?
  activatedAt  DateTime          @map("activated_at") @db.Timestamptz
  activatedBy  ProcessActivation @map("activated_by")
  /// The Modèle it was copied from, `null` once the Pilote drew it.
  templateName String?           @map("template_name")
  project      Project           @relation(fields: [pilotId, projectId], references: [pilotId, id], onDelete: Cascade)
  phaseRuns    PhaseRun[]

  @@unique([projectId, number])
  /// The key the PhaseRuns pinned to it point at, with their Pilote.
  @@unique([pilotId, id])
  @@index([pilotId, projectId])
  @@map("process_versions")
}

/// The Brouillon of a Projet's Process, one at most, saved whole on every
/// change of the canvas: `revision` counts its saves, `baseVersion` is the
/// version it was drawn from (`0` while the Projet has none).
model ProcessDraft {
  id          String   @id @db.Uuid
  pilotId     String   @map("pilot_id") @db.Uuid
  projectId   String   @unique @map("project_id") @db.Uuid
  definition  Json
  sealed      Json?
  revision    Int
  baseVersion Int      @map("base_version")
  updatedAt   DateTime @map("updated_at") @db.Timestamptz
  project     Project  @relation(fields: [pilotId, projectId], references: [pilotId, id], onDelete: Cascade)

  /// The one-to-one key of its Projet, with their Pilote.
  @@unique([pilotId, projectId])
  @@map("process_drafts")
}

/// Where a PhaseRun stands (`zPhaseRunState`).
enum PhaseRunState {
  running
  waiting
  done
  stopped
  failed

  @@map("phase_run_state")
}

/// Where a StepRun stands (`zStepRunState`).
enum StepRunState {
  running
  waiting
  interrupted
  blocked
  done
  failed
  stopped
  superseded

  @@map("step_run_state")
}

/// What an Étape that judges concludes (`zStepRunVerdict`).
enum StepVerdict {
  passed
  changes
  failed

  @@map("step_verdict")
}

/// One item through one Phase (ADR 0011, « The engine »), pinned to the
/// version active when it started: activating another never touches it.
/// One unfinished (`running` or `waiting`) per item and Phase, by the partial
/// unique indexes of the migrations. An Idée without a Projet (US-5) runs on
/// the release's « Process Crewdeck »: no Projet, no version row, its
/// `builtinTemplate` instead (the checks of `20261129000000_lineage`).
model PhaseRun {
  id               String          @id @db.Uuid
  pilotId          String          @map("pilot_id") @db.Uuid
  projectId        String?         @map("project_id") @db.Uuid
  processVersionId String?         @map("process_version_id") @db.Uuid
  /// The id of a `BUILTIN_TEMPLATES` definition, for a PhaseRun without a Projet.
  builtinTemplate  String?         @map("builtin_template")
  /// Lineage: the PhaseRun whose output became its item (a Ticket's
  /// Développement, its Conception), `null` when none did. Its foreign key
  /// sets only this column to null on delete (the migration's).
  parentPhaseRunId String?         @map("parent_phase_run_id") @db.Uuid
  phaseId          String          @map("phase_id")
  /// The type of its Phase's `forEach`, or of the Artefact that started a
  /// Phase without `forEach` (`zArtifactType`).
  itemType         String          @map("item_type")
  /// An Idée's or a Ticket's id, readable by the server.
  itemId           String          @map("item_id")
  state            PhaseRunState
  /// What a `waiting` one waits for (`zPhaseRunWaitingOn`).
  waitingOn        String?         @map("waiting_on")
  startedAt        DateTime        @map("started_at") @db.Timestamptz
  endedAt          DateTime?       @map("ended_at") @db.Timestamptz
  /// The starts asked by `retry` or `rerunFrom` that the start guard holds,
  /// by Étape: `{ iteration, reason, retryOf? }`, for `startQueued`. Codes
  /// and ids only, never shown: not in the view.
  pendingStarts    Json            @default("{}") @map("pending_starts")
  /// What the PhaseRun took of its Phase's Retours (`zPhaseRunLoopBack`):
  /// `{ from, to, taken, extra }`, ids and counts. In the view.
  loopBacks        Json            @default("[]") @map("loop_backs")
  lastSeq          BigInt          @default(0) @map("last_seq")
  project          Project?        @relation(fields: [pilotId, projectId], references: [pilotId, id], onDelete: Cascade)
  processVersion   ProcessVersion? @relation(fields: [pilotId, processVersionId], references: [pilotId, id], onDelete: Cascade)
  parent           PhaseRun?       @relation("Lineage", fields: [pilotId, parentPhaseRunId], references: [pilotId, id], onDelete: NoAction)
  children         PhaseRun[]      @relation("Lineage")
  stepRuns         StepRun[]

  /// The key its StepRuns and its children point at, with their Pilote.
  @@unique([pilotId, id])
  @@unique([projectId, phaseId, itemType, itemId], map: "phase_runs_project_id_phase_id_item_unfinished_key", where: raw("state IN ('running', 'waiting')"))
  @@unique([pilotId, builtinTemplate, phaseId, itemType, itemId], map: "phase_runs_builtin_phase_id_item_unfinished_key", where: raw("state IN ('running', 'waiting') AND project_id IS NULL"))
  @@index([pilotId, projectId, state])
  @@index([pilotId, itemType, itemId])
  @@index([pilotId, parentPhaseRunId])
  @@map("phase_runs")
}

/// One pass of an Étape in a PhaseRun (ADR 0011): what fed its Entrées and
/// what it gave, as Artefact references (`zArtifactRef`), never content
/// (ADR 0003). Its kind's handler does the work; the engine alone writes its
/// state. An agent Étape's Session writes `sessionId` and `contratVerdict`
/// (RUNNER-12).
model StepRun {
  id             String       @id @db.Uuid
  pilotId        String       @map("pilot_id") @db.Uuid
  /// Its PhaseRun's: `null` for an Idée without a Projet.
  projectId      String?      @map("project_id") @db.Uuid
  phaseRunId     String       @map("phase_run_id") @db.Uuid
  stepId         String       @map("step_id")
  /// Its Étape's kind (`zStepKind`).
  kind           String
  iteration      Int          @default(1)
  state          StepRunState
  /// `{ portId, artifacts: ArtifactRef[], absent }[]`.
  inputs         Json
  /// `ArtifactRef[]`.
  outputs        Json         @default("[]")
  verdict        StepVerdict?
  /// A code (`no-handler`), never free text.
  failure        String?
  /// Why a rerun started it: `loop-back`, or the caller's (`fix-conflict`).
  reason         String?
  sessionId      String?      @map("session_id") @db.Uuid
  /// The verdict of its Contrat, from the Runner's `step.verdict` (RUNNER-12).
  contratVerdict Json?        @map("contrat_verdict")
  startedAt      DateTime     @map("started_at") @db.Timestamptz
  endedAt        DateTime?    @map("ended_at") @db.Timestamptz
  lastSeq        BigInt       @default(0) @map("last_seq")
  project        Project?     @relation(fields: [pilotId, projectId], references: [pilotId, id], onDelete: Cascade)
  phaseRun       PhaseRun     @relation(fields: [pilotId, phaseRunId], references: [pilotId, id], onDelete: Cascade)

  @@index([pilotId, phaseRunId])
  @@index([outputs(ops: JsonbPathOps)], type: Gin)
  @@map("step_runs")
}

/// A group of a Projet's artifacts (ADR 0012, « Which Source for what »):
/// `ticket`, its Tickets; `code`, its Changement de code and its documents.
enum SourceGroup {
  ticket
  code

  @@map("source_group")
}

/// Where a group lives: a folder of the Pilote's machine, or a Dépôt GitHub.
enum SourceKind {
  local
  github

  @@map("source_kind")
}

/// The Source of one group of a Projet (SOURCE-1): both rows written at its
/// creation, `since` then; moving a group (SOURCE-7) updates `source` and
/// `since`.
model ArtifactSource {
  id        String      @id @db.Uuid
  pilotId   String      @map("pilot_id") @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  group     SourceGroup
  source    SourceKind
  since     DateTime    @db.Timestamptz
  project   Project     @relation(fields: [pilotId, projectId], references: [pilotId, id], onDelete: Cascade)

  @@unique([projectId, group])
  @@index([pilotId, projectId])
  @@map("artifact_sources")
}

enum IdeaState {
  analysing
  to_triage @map("to-triage")
  analysed
  retained
  merged
  rejected

  @@map("idea_state")
}

enum IdeaNotedFrom {
  pc
  telephone

  @@map("idea_noted_from")
}

/// An Idée (IDEE-1, US-5): its text sealed in the Pilote's browser (ADR 0003),
/// as its analysis and the reason of its triage: the server stores the
/// ciphertexts (`{ key, ciphertext }`, JSON) and never reads them. `number`
/// is its `#<n>`, from `pilots.idea_seq`. Its Projets are the same Pilote's
/// (the foreign keys carry `pilot_id`); a Projet is never deleted yet.
model Idea {
  id              String        @id @db.Uuid
  pilotId         String        @map("pilot_id") @db.Uuid
  number          Int
  projectId       String?       @map("project_id") @db.Uuid
  targetProjectId String?       @map("target_project_id") @db.Uuid
  targetIsNew     Boolean       @default(false) @map("target_is_new")
  state           IdeaState
  text            Json
  analysis        Json?
  impact          Int?
  effort          Int?
  duplicateIds    String[]      @default([]) @map("duplicate_ids") @db.Uuid
  notedFrom       IdeaNotedFrom @map("noted_from")
  dictated        Boolean       @default(false)
  mergedIntoId    String?       @map("merged_into_id") @db.Uuid
  reason          Json?
  ticketNumber    Int?          @map("ticket_number")
  createdAt       DateTime      @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @map("updated_at") @db.Timestamptz
  analysedAt      DateTime?     @map("analysed_at") @db.Timestamptz
  triagedAt       DateTime?     @map("triaged_at") @db.Timestamptz
  /// The `seq` of its last `idea.upserted`: a command on it carries it (ADR 0007).
  lastSeq         BigInt        @default(0) @map("last_seq")
  pilot           Pilot         @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  project         Project?      @relation("IdeaProject", fields: [pilotId, projectId], references: [pilotId, id], onDelete: NoAction)
  targetProject   Project?      @relation("IdeaTarget", fields: [pilotId, targetProjectId], references: [pilotId, id], onDelete: NoAction)

  @@unique([pilotId, number])
  @@index([pilotId, state, updatedAt])
  @@map("ideas")
}

/// A Session's state (`SESSION_STATES`).
enum AgentSessionState {
  starting
  active
  waiting
  stopped
  interrupted
  ended

  @@map("agent_session_state")
}

/// How an `ended` Session ended (`SESSION_OUTCOMES`).
enum AgentSessionOutcome {
  ok
  error

  @@map("agent_session_outcome")
}

/// Why an `ended` Session ended in `error` (`SESSION_ERRORS`): a code, never the error's text.
enum AgentSessionError {
  setup_failed  @map("setup-failed")
  branch_busy   @map("branch-busy")
  engine_failed @map("engine-failed")
  clone_failed  @map("clone-failed")

  @@map("agent_session_error")
}

/// Why a Session is `interrupted` (`SESSION_INTERRUPTED_REASONS`).
enum AgentSessionInterruptedReason {
  runner_offline   @map("runner-offline")
  runner_restarted @map("runner-restarted")

  @@map("agent_session_interrupted_reason")
}

/// A Session (RUNNER-9): one conversation of an agent in one Rôle, on the
/// Runner, with one Moteur, in the worktree of `branch`. Its state only: its
/// content stays in the Runner's log (SESSION-1 relays it). `title` is
/// readable for a GitHub Projet (a Ticket's or a Conception's title, ADR
/// 0003); nothing else is free text.
model AgentSession {
  id                String                         @id @db.Uuid
  pilotId           String                         @map("pilot_id") @db.Uuid
  projectId         String                         @map("project_id") @db.Uuid
  /// A Rôle's id (`zRoleId`): one of the four defaults, or one the Pilote added.
  role              String
  engine            EngineId
  model             String
  title             String
  branch            String
  /// The branch the worktree starts from when `branch` is not on the remote.
  base              String
  permissionMode    String                         @map("permission_mode")
  state             AgentSessionState
  interruptedReason AgentSessionInterruptedReason? @map("interrupted_reason")
  outcome           AgentSessionOutcome?
  error             AgentSessionError?
  /// Its StepRun's, with no foreign key: the StepRun points at it by its own `sessionId`.
  stepRunId         String?                        @map("step_run_id") @db.Uuid
  /// The Étape's kind of its StepRun, which the Runner builds the first message from.
  stepKind          String?                        @map("step_kind")
  /// The Moteur's own id of the Session, once the Runner reported it: what a resume takes.
  engineSessionId   String?                        @map("engine_session_id")
  startedAt         DateTime                       @map("started_at") @db.Timestamptz
  endedAt           DateTime?                      @map("ended_at") @db.Timestamptz
  lastSeq           BigInt                         @default(0) @map("last_seq")
  pilot             Pilot                          @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  project           Project                        @relation(fields: [pilotId, projectId], references: [pilotId, id], onDelete: Cascade)

  @@index([pilotId, projectId, startedAt])
  @@index([pilotId, state])
  @@map("agent_sessions")
}
