{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "server",
  "projectType": "application",
  "sourceRoot": "apps/server/src",
  "tags": ["scope:server"],
  "targets": {
    "prisma-generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/prisma/schema.prisma", "{projectRoot}/prisma.config.ts"],
      "outputs": ["{projectRoot}/src/generated/prisma"],
      "options": { "command": "prisma generate", "cwd": "{projectRoot}" }
    },
    "typecheck": { "dependsOn": ["prisma-generate", "^typecheck"] },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["prisma-generate", "^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "options": { "command": "tsc --build tsconfig.app.json", "cwd": "{projectRoot}" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "tsc --build tsconfig.app.json --watch --preserveWatchOutput",
          "CREWDECK_ENV=${CREWDECK_ENV:-development} node --watch-path=dist --env-file-if-exists=../../.env --enable-source-maps dist/main.js"
        ],
        "parallel": true,
        "cwd": "{projectRoot}"
      }
    },
    "test": { "dependsOn": ["prisma-generate"] },
    "test-integration": {
      "executor": "nx:run-commands",
      "dependsOn": ["prisma-generate"],
      "options": { "command": "vitest run --config vitest.integration.config.ts", "cwd": "{projectRoot}" }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": { "command": "prisma migrate deploy", "cwd": "{projectRoot}" }
    }
  }
}
