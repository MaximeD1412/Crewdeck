{
  "name": "@crewdeck/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@crewdeck/contracts": "workspace:*",
    "@crewdeck/sdk": "workspace:*",
    "@crewdeck/skin-passerelle": "workspace:*",
    "lit": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "happy-dom": "catalog:",
    "zod": "catalog:"
  },
  "nx": {
    "name": "web",
    "tags": [
      "scope:web"
    ],
    "targets": {
      "e2e": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "playwright test",
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
