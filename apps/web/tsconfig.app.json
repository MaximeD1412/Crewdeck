{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "out-tsc/app",
    "tsBuildInfoFile": "out-tsc/app/tsconfig.app.tsbuildinfo",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts"
  ],
  "references": [
    {
      "path": "../../packages/skin-passerelle/tsconfig.lib.json"
    },
    {
      "path": "../../packages/sdk/tsconfig.lib.json"
    },
    {
      "path": "../../packages/contracts/tsconfig.lib.json"
    }
  ]
}
