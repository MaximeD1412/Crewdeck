# /opt/crewdeck/backup/restic.env (mode 600, owner deploy: install.sh sets
# both): the restic repository of production's backups, read by backup.sh
# (root, nightly) and rehearse.sh (deploy, at each production deploy). Written
# on the VPS by INFRA-13 from this template; never committed, never in GitHub.
# The same values live in the founder's password manager, entry « Crewdeck
# backups », for restore-check.sh from their machine (with the path of a local
# password file).

# The S3-compatible bucket at another provider than OVH (ADR 0009):
# s3:<endpoint>/<bucket>.
RESTIC_REPOSITORY=
# The path of the file holding the password (openssl rand -base64 32), mode
# 600 like this one; never the password itself in this file.
RESTIC_PASSWORD_FILE=/opt/crewdeck/backup/restic.password
# The access key restricted to that bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
