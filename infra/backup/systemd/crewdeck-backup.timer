[Unit]
Description=Déclenche la sauvegarde restic de la production de Crewdeck, chaque nuit

[Timer]
# In UTC, whatever the machine's zone: no night skipped or doubled when the
# clocks change. backup-watch (07:00 UTC) checks it.
OnCalendar=*-*-* 01:30:00 UTC
# A night missed while the VPS was down runs at boot.
Persistent=true
RandomizedDelaySec=10m

[Install]
WantedBy=timers.target
