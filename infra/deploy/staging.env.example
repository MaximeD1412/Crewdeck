# /opt/crewdeck/staging/.env (mode 600, owner deploy): every key of staging, read
# both by Compose (--env-file) and by the server (env_file). Filled by INFRA-12
# from this template; never committed. An empty value counts as unset. The
# tickets that read a key add it to apps/server/src/config/env.ts; this file is
# the list.

# --- The environment
CREWDECK_ENV=staging
# This very file: Compose hands it to the server (docker-compose.yml, env_file).
CREWDECK_ENV_FILE=/opt/crewdeck/staging/.env
# The URL the Pilote opens, https://staging.<domain> (the DNS of INFRA-12).
PUBLIC_URL=
# The image's commit: written by the deploy (INFRA-6), never by hand.
CREWDECK_SHA=

# --- PostgreSQL (the project's own, service db)
# openssl rand -hex 32: hexadecimal, since it goes into DATABASE_URL as is.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://crewdeck:${POSTGRES_PASSWORD}@db:5432/crewdeck

# --- Sessions
# openssl rand -base64 48 (CORE-3).
SESSION_SECRET=

# --- The GitHub App « Crewdeck staging » (INFRA-11, read by CORE-3)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# base64 -w0 <the App's private key>.pem: one line, no newline in the file.
GITHUB_APP_PRIVATE_KEY=
# The webhook secret set in the App's settings.
GITHUB_WEBHOOK_SECRET=
# openssl rand -base64 32: encrypts the users' GitHub tokens at rest (CORE-4).
GITHUB_TOKEN_KEY=

# --- Web Push (ATOI-4)
# npx web-push generate-vapid-keys: a pair of its own per environment.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:<the founder's address>.
VAPID_SUBJECT=

# --- Production's values, which staging refuses to start with
# (apps/server/src/config/staging-guard.ts): copied from /opt/crewdeck/prod/.env.
# https://<domain>, production's PUBLIC_URL.
PROD_PUBLIC_URL=
# Production's GITHUB_APP_ID (the App « Crewdeck », INFRA-11).
PROD_GITHUB_APP_ID=
