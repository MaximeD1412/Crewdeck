# /opt/crewdeck/edge/.env (mode 600), filled by INFRA-12.

# The production domain, without scheme; staging is staging.<domain>. Its DNS
# records (A and AAAA, both names) point at the VPS (INFRA-12).
CREWDECK_DOMAIN=
# The address Let's Encrypt writes to about the certificates: the founder's.
ACME_EMAIL=
