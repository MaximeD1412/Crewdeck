{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "at": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "kind": {
      "const": "question",
      "type": "string"
    },
    "multiple": {
      "type": "boolean"
    },
    "options": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "type": "string"
          },
          "label": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "label"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "raw": {
      "goJSONSchema": {
        "imports": [
          "encoding/json"
        ],
        "nillable": true,
        "type": "json.RawMessage"
      }
    },
    "requestId": {
      "minLength": 1,
      "type": "string"
    },
    "seq": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "at",
    "kind",
    "multiple",
    "options",
    "requestId",
    "seq",
    "title"
  ],
  "title": "EngineEventQuestion",
  "type": "object"
}
