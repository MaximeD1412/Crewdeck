{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "at": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "holderId": {
      "pattern": "^[A-Za-z0-9_-]*$",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "type": "string"
    },
    "kind": {
      "enum": [
        "file",
        "ticket",
        "change",
        "diff",
        "command-output"
      ],
      "type": "string"
    },
    "projectId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "type": "string"
    },
    "ref": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "allOf": [
            {
              "pattern": "^[A-Za-z0-9._/-]+$"
            },
            {
              "pattern": "^[^-]"
            }
          ],
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        "base": {
          "allOf": [
            {
              "pattern": "^[A-Za-z0-9._/-]+$"
            },
            {
              "pattern": "^[^-]"
            }
          ],
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        "head": {
          "allOf": [
            {
              "pattern": "^[A-Za-z0-9._/-]+$"
            },
            {
              "pattern": "^[^-]"
            }
          ],
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        "number": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\0]+$",
          "type": "string"
        },
        "runId": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "requestId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "type": "string"
    },
    "tabId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "type": "string"
    },
    "type": {
      "const": "artifact.read",
      "type": "string"
    }
  },
  "required": [
    "at",
    "holderId",
    "id",
    "kind",
    "projectId",
    "ref",
    "requestId",
    "tabId",
    "type"
  ],
  "title": "RunnerArtifactRead",
  "type": "object"
}
