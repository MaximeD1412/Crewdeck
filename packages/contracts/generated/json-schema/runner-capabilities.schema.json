{
  "$defs": {
    "EngineCapabilities": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "subscription",
                "api-key",
                "none"
              ],
              "type": "string"
            },
            "state": {
              "enum": [
                "connected",
                "login-required"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind",
            "state"
          ],
          "type": "object"
        },
        "engine": {
          "$ref": "#/$defs/EngineId"
        },
        "features": {
          "additionalProperties": false,
          "properties": {
            "interrupt": {
              "type": "boolean"
            },
            "permissions": {
              "type": "boolean"
            },
            "questions": {
              "type": "boolean"
            },
            "resume": {
              "type": "boolean"
            }
          },
          "required": [
            "interrupt",
            "permissions",
            "questions",
            "resume"
          ],
          "type": "object"
        },
        "installed": {
          "type": "boolean"
        },
        "knownVersion": {
          "type": "boolean"
        },
        "models": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "label": {
                "minLength": 1,
                "type": "string"
              },
              "reason": {
                "enum": [
                  "login-required",
                  "quota-reached",
                  "not-in-plan"
                ],
                "type": "string"
              },
              "usable": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "label",
              "usable"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "account",
        "engine",
        "features",
        "installed",
        "knownVersion",
        "models"
      ],
      "type": "object"
    },
    "EngineId": {
      "enum": [
        "claude-code",
        "codex"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "at": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "engines": {
      "items": {
        "$ref": "#/$defs/EngineCapabilities"
      },
      "maxItems": 16,
      "type": "array"
    },
    "id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "type": "string"
    },
    "type": {
      "const": "capabilities",
      "type": "string"
    }
  },
  "required": [
    "at",
    "engines",
    "id",
    "type"
  ],
  "title": "RunnerCapabilities",
  "type": "object"
}
