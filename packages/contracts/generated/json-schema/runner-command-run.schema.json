{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "at": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "commandId": {
      "maxLength": 40,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "type": "string"
    },
    "integrationBranch": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+$",
      "type": "string"
    },
    "origin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "github"
          ],
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z0-9._-]{1,100}$",
          "type": "string"
        },
        "owner": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "owner"
      ],
      "type": "object"
    },
    "projectId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "type": "string"
    },
    "ref": {
      "additionalProperties": false,
      "properties": {
        "branch": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._/-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "stepId": {
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        "ticket": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "branch",
        "sha",
        "stepId",
        "ticket"
      ],
      "type": "object"
    },
    "runId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "type": "string"
    },
    "sealed": {
      "additionalProperties": false,
      "properties": {
        "ciphertext": {
          "pattern": "^[A-Za-z0-9_-]*$",
          "type": "string"
        },
        "key": {
          "pattern": "^[A-Za-z0-9_-]*$",
          "type": "string"
        }
      },
      "required": [
        "ciphertext",
        "key"
      ],
      "type": "object"
    },
    "type": {
      "const": "command.run",
      "type": "string"
    }
  },
  "required": [
    "at",
    "commandId",
    "id",
    "integrationBranch",
    "origin",
    "projectId",
    "ref",
    "runId",
    "sealed",
    "type"
  ],
  "title": "RunnerCommandRun",
  "type": "object"
}
