{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "holders": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "approverPublicKey": {
            "pattern": "^[A-Za-z0-9_-]*$",
            "type": "string"
          },
          "deviceId": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
            "type": "string"
          },
          "publicKey": {
            "pattern": "^[A-Za-z0-9_-]*$",
            "type": "string"
          },
          "wrap": {
            "additionalProperties": false,
            "properties": {
              "ciphertext": {
                "pattern": "^[A-Za-z0-9_-]*$",
                "type": "string"
              },
              "enc": {
                "pattern": "^[A-Za-z0-9_-]*$",
                "type": "string"
              },
              "tag": {
                "pattern": "^[A-Za-z0-9_-]*$",
                "type": "string"
              }
            },
            "required": [
              "ciphertext",
              "enc",
              "tag"
            ],
            "type": "object"
          }
        },
        "required": [
          "approverPublicKey",
          "deviceId",
          "publicKey",
          "wrap"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "vouchers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "approverPublicKey": {
            "pattern": "^[A-Za-z0-9_-]*$",
            "type": "string"
          },
          "deviceId": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
            "type": "string"
          },
          "publicKey": {
            "pattern": "^[A-Za-z0-9_-]*$",
            "type": "string"
          },
          "wrap": {
            "additionalProperties": false,
            "properties": {
              "ciphertext": {
                "pattern": "^[A-Za-z0-9_-]*$",
                "type": "string"
              },
              "enc": {
                "pattern": "^[A-Za-z0-9_-]*$",
                "type": "string"
              },
              "tag": {
                "pattern": "^[A-Za-z0-9_-]*$",
                "type": "string"
              }
            },
            "required": [
              "ciphertext",
              "enc",
              "tag"
            ],
            "type": "object"
          }
        },
        "required": [
          "approverPublicKey",
          "deviceId",
          "publicKey",
          "wrap"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "holders"
  ],
  "title": "RunnerDeviceHolders",
  "type": "object"
}
