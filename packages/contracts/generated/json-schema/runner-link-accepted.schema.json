{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "browserPairing": {
      "additionalProperties": false,
      "properties": {
        "deviceName": {
          "maxLength": 60,
          "minLength": 1,
          "type": "string"
        },
        "devicePublicKey": {
          "pattern": "^[A-Za-z0-9_-]*$",
          "type": "string"
        }
      },
      "required": [
        "deviceName",
        "devicePublicKey"
      ],
      "type": "object"
    },
    "linkId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "type": "string"
    }
  },
  "required": [
    "browserPairing",
    "linkId"
  ],
  "title": "RunnerLinkAccepted",
  "type": "object"
}
