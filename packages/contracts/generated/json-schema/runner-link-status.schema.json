{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "pairing": {
      "additionalProperties": {},
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "reason": {
      "enum": [
        "expired",
        "already-used",
        "unsupported-system",
        "no-engine"
      ],
      "type": "string"
    },
    "runnerId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "type": "string"
    },
    "state": {
      "enum": [
        "pending",
        "linked",
        "failed"
      ],
      "type": "string"
    },
    "token": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "state"
  ],
  "title": "RunnerLinkStatus",
  "type": "object"
}
