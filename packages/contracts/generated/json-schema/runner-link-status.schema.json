{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "pairing": {
      "additionalProperties": false,
      "properties": {
        "proof": {
          "pattern": "^[A-Za-z0-9_-]*$",
          "type": "string"
        },
        "runnerVaultWrap": {
          "additionalProperties": false,
          "properties": {
            "ciphertext": {
              "pattern": "^[A-Za-z0-9_-]*$",
              "type": "string"
            },
            "enc": {
              "pattern": "^[A-Za-z0-9_-]*$",
              "type": "string"
            },
            "tag": {
              "pattern": "^[A-Za-z0-9_-]*$",
              "type": "string"
            }
          },
          "required": [
            "ciphertext",
            "enc",
            "tag"
          ],
          "type": "object"
        },
        "vaultKeyVersion": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      },
      "required": [
        "proof",
        "runnerVaultWrap",
        "vaultKeyVersion"
      ],
      "type": "object"
    },
    "reason": {
      "enum": [
        "expired",
        "already-used",
        "unsupported-system",
        "no-engine",
        "pairing-mismatch",
        "device-not-trusted"
      ],
      "type": "string"
    },
    "runnerId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "type": "string"
    },
    "state": {
      "enum": [
        "pending",
        "linked",
        "failed"
      ],
      "type": "string"
    },
    "token": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "state"
  ],
  "title": "RunnerLinkStatus",
  "type": "object"
}
