{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "at": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "type": "string"
    },
    "projects": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "displayName": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "githubRepoId": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "installationId": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "integrationBranch": {
            "minLength": 1,
            "type": "string"
          },
          "nameSealed": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "ciphertext": {
                    "pattern": "^[A-Za-z0-9_-]*$",
                    "type": "string"
                  },
                  "key": {
                    "pattern": "^[A-Za-z0-9_-]*$",
                    "type": "string"
                  }
                },
                "required": [
                  "ciphertext",
                  "key"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "projectId": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
            "type": "string"
          },
          "repository": {
            "anyOf": [
              {
                "pattern": "^[^/\\s]+\\/[^/\\s]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "sources": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "local",
                  "github"
                ],
                "type": "string"
              },
              "ticket": {
                "enum": [
                  "local",
                  "github"
                ],
                "type": "string"
              }
            },
            "required": [
              "code",
              "ticket"
            ],
            "type": "object"
          }
        },
        "required": [
          "displayName",
          "githubRepoId",
          "installationId",
          "integrationBranch",
          "nameSealed",
          "projectId",
          "repository",
          "sources"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "type": {
      "const": "mirror.projects",
      "type": "string"
    }
  },
  "required": [
    "at",
    "id",
    "projects",
    "type"
  ],
  "title": "RunnerMirrorProjects",
  "type": "object"
}
