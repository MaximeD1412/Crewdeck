{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "at": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "base": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._/-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "branch": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._/-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "engine": {
      "enum": [
        "claude-code",
        "codex"
      ],
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "type": "string"
    },
    "mcpServers": {
      "items": {
        "maxLength": 60,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 10,
      "type": "array"
    },
    "model": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "origin": {
      "anyOf": [
        {
          "goJSONSchema": {
            "type": "Origin"
          },
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "github",
                  "type": "string"
                },
                "name": {
                  "pattern": "^[A-Za-z0-9._-]{1,100}$",
                  "type": "string"
                },
                "owner": {
                  "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "name",
                "owner"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "local",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "goJSONSchema": {
        "type": "*Origin"
      }
    },
    "permissionMode": {
      "enum": [
        "auto",
        "bypass"
      ],
      "type": "string"
    },
    "projectId": {
      "anyOf": [
        {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "role": {
      "pattern": "^(?:idea|design|code|review|r-[a-z0-9]{8})$",
      "type": "string"
    },
    "sessionId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "type": "string"
    },
    "step": {
      "additionalProperties": false,
      "properties": {
        "contractId": {
          "anyOf": [
            {
              "maxLength": 60,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ideas": {
          "additionalProperties": false,
          "properties": {
            "idea": {
              "additionalProperties": false,
              "properties": {
                "analysis": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "ciphertext": {
                          "pattern": "^[A-Za-z0-9_-]*$",
                          "type": "string"
                        },
                        "key": {
                          "pattern": "^[A-Za-z0-9_-]*$",
                          "type": "string"
                        }
                      },
                      "required": [
                        "ciphertext",
                        "key"
                      ],
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "id": {
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
                  "type": "string"
                },
                "number": {
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                "text": {
                  "additionalProperties": false,
                  "properties": {
                    "ciphertext": {
                      "pattern": "^[A-Za-z0-9_-]*$",
                      "type": "string"
                    },
                    "key": {
                      "pattern": "^[A-Za-z0-9_-]*$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "ciphertext",
                    "key"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "analysis",
                "id",
                "number",
                "text"
              ],
              "type": "object"
            },
            "open": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "analysis": {
                    "anyOf": [
                      {
                        "additionalProperties": false,
                        "properties": {
                          "ciphertext": {
                            "pattern": "^[A-Za-z0-9_-]*$",
                            "type": "string"
                          },
                          "key": {
                            "pattern": "^[A-Za-z0-9_-]*$",
                            "type": "string"
                          }
                        },
                        "required": [
                          "ciphertext",
                          "key"
                        ],
                        "type": "object"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "id": {
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
                    "type": "string"
                  },
                  "number": {
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  },
                  "text": {
                    "additionalProperties": false,
                    "properties": {
                      "ciphertext": {
                        "pattern": "^[A-Za-z0-9_-]*$",
                        "type": "string"
                      },
                      "key": {
                        "pattern": "^[A-Za-z0-9_-]*$",
                        "type": "string"
                      }
                    },
                    "required": [
                      "ciphertext",
                      "key"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "analysis",
                  "id",
                  "number",
                  "text"
                ],
                "type": "object"
              },
              "maxItems": 100,
              "type": "array"
            },
            "vaultKeyVersion": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            }
          },
          "required": [
            "idea",
            "open",
            "vaultKeyVersion"
          ],
          "type": "object"
        },
        "inputs": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "portId": {
                "maxLength": 40,
                "minLength": 1,
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                "type": "string"
              },
              "ref": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "maxLength": 200,
                        "minLength": 1,
                        "type": "string"
                      },
                      "number": {
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991,
                        "type": "integer"
                      },
                      "sha": {
                        "pattern": "^[0-9a-f]{40}$",
                        "type": "string"
                      }
                    },
                    "required": [
                      "id"
                    ],
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": {
                "enum": [
                  "idea",
                  "prd",
                  "mockups",
                  "technical-design",
                  "inventory",
                  "ticket",
                  "code-change",
                  "verdict",
                  "delivery"
                ],
                "type": "string"
              }
            },
            "required": [
              "portId",
              "ref",
              "type"
            ],
            "type": "object"
          },
          "maxItems": 200,
          "type": "array"
        },
        "skill": {
          "maxLength": 60,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        "stepKind": {
          "enum": [
            "idea-analysis",
            "inventory",
            "prd",
            "mockups",
            "technical-design",
            "cross-review",
            "split",
            "code",
            "review"
          ],
          "type": "string"
        },
        "stepRunId": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
          "type": "string"
        }
      },
      "required": [
        "contractId",
        "inputs",
        "skill",
        "stepKind",
        "stepRunId"
      ],
      "type": "object"
    },
    "title": {
      "anyOf": [
        {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "type": {
      "const": "session.start",
      "type": "string"
    },
    "worktreeCommands": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "ciphertext": {
              "pattern": "^[A-Za-z0-9_-]*$",
              "type": "string"
            },
            "key": {
              "pattern": "^[A-Za-z0-9_-]*$",
              "type": "string"
            }
          },
          "required": [
            "ciphertext",
            "key"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "at",
    "base",
    "branch",
    "engine",
    "id",
    "mcpServers",
    "model",
    "origin",
    "permissionMode",
    "projectId",
    "role",
    "sessionId",
    "title",
    "type",
    "worktreeCommands"
  ],
  "title": "RunnerSessionStart",
  "type": "object"
}
