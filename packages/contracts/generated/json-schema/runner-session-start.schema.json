{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "at": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "base": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+$",
      "type": "string"
    },
    "branch": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+$",
      "type": "string"
    },
    "engine": {
      "enum": [
        "claude-code",
        "codex"
      ],
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "type": "string"
    },
    "model": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "origin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "github"
          ],
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z0-9._-]{1,100}$",
          "type": "string"
        },
        "owner": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "owner"
      ],
      "type": "object"
    },
    "permissionMode": {
      "enum": [
        "auto",
        "bypass"
      ],
      "type": "string"
    },
    "projectId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "type": "string"
    },
    "role": {
      "pattern": "^(?:idea|design|code|review|r-[a-z0-9]{8})$",
      "type": "string"
    },
    "sessionId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "type": "string"
    },
    "step": {
      "additionalProperties": false,
      "properties": {
        "stepKind": {
          "enum": [
            "idea-analysis",
            "inventory",
            "prd",
            "mockups",
            "technical-design",
            "cross-review",
            "split",
            "code",
            "review"
          ],
          "type": "string"
        },
        "stepRunId": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
          "type": "string"
        }
      },
      "required": [
        "stepKind",
        "stepRunId"
      ],
      "type": "object"
    },
    "title": {
      "maxLength": 300,
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "const": "session.start",
      "type": "string"
    },
    "worktreeCommands": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "ciphertext": {
              "pattern": "^[A-Za-z0-9_-]*$",
              "type": "string"
            },
            "key": {
              "pattern": "^[A-Za-z0-9_-]*$",
              "type": "string"
            }
          },
          "required": [
            "ciphertext",
            "key"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "at",
    "base",
    "branch",
    "engine",
    "id",
    "model",
    "origin",
    "permissionMode",
    "projectId",
    "role",
    "sessionId",
    "title",
    "type",
    "worktreeCommands"
  ],
  "title": "RunnerSessionStart",
  "type": "object"
}
