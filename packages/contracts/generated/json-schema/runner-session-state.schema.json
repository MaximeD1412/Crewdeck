{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "at": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "engineSessionId": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "error": {
      "enum": [
        "setup-failed",
        "branch-busy",
        "engine-failed",
        "clone-failed"
      ],
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "ok",
        "error"
      ],
      "type": "string"
    },
    "sessionId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "type": "string"
    },
    "state": {
      "enum": [
        "starting",
        "active",
        "waiting",
        "stopped",
        "interrupted",
        "ended"
      ],
      "type": "string"
    },
    "type": {
      "const": "session.state",
      "type": "string"
    }
  },
  "required": [
    "at",
    "id",
    "sessionId",
    "state",
    "type"
  ],
  "title": "RunnerSessionState",
  "type": "object"
}
