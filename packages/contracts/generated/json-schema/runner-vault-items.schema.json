{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "aad": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "itemId": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
            "type": "string"
          },
          "itemType": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z-]*\\.[a-z][a-z-]*$",
            "type": "string"
          },
          "wrappedKey": {
            "pattern": "^[A-Za-z0-9_-]*$",
            "type": "string"
          }
        },
        "required": [
          "aad",
          "itemId",
          "itemType",
          "wrappedKey"
        ],
        "type": "object"
      },
      "maxItems": 500,
      "type": "array"
    },
    "nextCursor": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "items",
    "nextCursor"
  ],
  "title": "RunnerVaultItems",
  "type": "object"
}
