{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "enum": [
        "allow",
        "allow-session",
        "deny"
      ],
      "type": "string"
    },
    "kind": {
      "const": "permission",
      "type": "string"
    },
    "requestId": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "decision",
    "kind",
    "requestId"
  ],
  "title": "SessionInputPermission",
  "type": "object"
}
