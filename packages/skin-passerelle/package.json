{
  "name": "@crewdeck/skin-passerelle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@crewdeck/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./icons": {
      "@crewdeck/source": "./src/icons.ts",
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js",
      "default": "./dist/icons.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./fonts.css": "./src/fonts.css",
    "./document.css": "./src/document.css",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@crewdeck/sdk": "workspace:*",
    "@fontsource/ibm-plex-mono": "catalog:",
    "@fontsource/ibm-plex-sans": "catalog:",
    "@fontsource/ibm-plex-sans-condensed": "catalog:",
    "lit": "catalog:",
    "markdown-it": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:"
  },
  "nx": {
    "name": "skin-passerelle",
    "tags": [
      "scope:skin"
    ],
    "targets": {
      "tokens": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node scripts/tokens.mjs",
          "cwd": "{projectRoot}"
        },
        "inputs": [
          "{projectRoot}/scripts/tokens.mjs",
          "{workspaceRoot}/design/tokens.json"
        ],
        "outputs": [
          "{projectRoot}/src/tokens.css"
        ]
      }
    }
  }
}
